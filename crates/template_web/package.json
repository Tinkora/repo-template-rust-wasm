{
  "name": "template-web-smoke",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:wasm": "wasm-pack build --target web .",
    "prepare:wasm-smoke": "node scripts/prepare-wasm-smoke.mjs",
    "serve": "http-server . -a 127.0.0.1 -p 4173 -c-1 --silent",
    "test:browser-config": "node --test scripts/playwright-config.test.mjs",
    "test:prepare-wasm-smoke": "node --test scripts/prepare-wasm-smoke.test.mjs",
    "test:wasm-smoke": "npm run test:browser-config && npm run test:prepare-wasm-smoke && npm run prepare:wasm-smoke && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "http-server": "14.1.1"
  }
}
